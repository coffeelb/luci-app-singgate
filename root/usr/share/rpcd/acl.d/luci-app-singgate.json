{
	"luci-app-singgate": {
		"description": "Grant access to SingGate",
		"read": {
			"file": {
				"/etc/singgate/config.json": [ "read" ]
			},
			"ubus": {
				"service": [ "list" ]
			}
		},
		"write": {
			"file": {
				"/etc/singgate/config.json": [ "write" ],
				"/tmp/singgate-check.json": [ "write" ],
				"/usr/bin/sing-box": [ "exec" ],
				"/etc/init.d/singgate": [ "exec" ]
			}
		}
	}
}
