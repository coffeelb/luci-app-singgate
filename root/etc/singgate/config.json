{
  "log": {
    "level": "error",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "tag": "main-dns",
        "detour": "main-out",
        "type": "https",
        "server": "dns.google",
        "path": "/dns-query"
      },
      {
        "tag": "china-dns",
        "type": "udp",
        "server": "223.5.5.5"
      }
    ],
    "rules": [
      {
        "rule_set": "geosite-cn",
        "action": "route",
        "server": "china-dns"
      },
      {
        "action": "evaluate",
        "server": "main-dns"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "match_response": true,
            "response_rcode": "SERVFAIL"
          },
          {
            "match_response": true,
            "response_rcode": "REFUSED"
          }
        ],
        "action": "route",
        "server": "china-dns"
      },
      {
        "match_response": true,
        "rule_set": "geoip-cn",
        "action": "route",
        "server": "china-dns"
      },
      {
        "match_response": true,
        "action": "respond"
      }
    ],
    "optimistic": {
      "enabled": true,
      "timeout": "1h"
    },
    "reverse_mapping": true,
    "final": "main-dns"
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "interface_name": "singtun0",
      "address": [
        "172.19.0.1/30",
        "fdfe:dcba:9876::1/126"
      ],
      "mtu": 9000,
      "auto_route": true,
      "auto_redirect": true,
      "strict_route": false,
      "exclude_mptcp": true,
      "multi_queue": true,
      "dns_mode": "hijack"
    },
    {
      "type": "direct",
      "tag": "dns-in",
      "listen": "::",
      "listen_port": 5333
    },
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "::",
      "listen_port": 5330
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct-out"
    },
    {
      "type": "selector",
      "tag": "main-out",
      "outbounds": [
        "direct-out"
      ],
      "default": "direct-out",
      "interrupt_exist_connections": true
    }
  ],
  "route": {
    "rules": [
      {
        "inbound": "dns-in",
        "action": "hijack-dns"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "type": "logical",
            "mode": "and",
            "rules": [
              {
                "inbound": "tun-in"
              },
              {
                "ip_is_private": true
              }
            ]
          },
          {
            "source_ip_cidr": [
              "172.19.0.1/30",
              "fdfe:dcba:9876::1/126"
            ],
            "invert": true
          }
        ],
        "action": "bypass"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "type": "logical",
            "mode": "and",
            "rules": [
              {
                "inbound": "tun-in"
              },
              {
                "rule_set": "geosite-cn"
              }
            ]
          },
          {
            "source_ip_cidr": [
              "172.19.0.1/30",
              "fdfe:dcba:9876::1/126"
            ],
            "invert": true
          }
        ],
        "action": "bypass"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "type": "logical",
            "mode": "and",
            "rules": [
              {
                "inbound": "tun-in"
              },
              {
                "rule_set": "geoip-cn"
              }
            ]
          },
          {
            "source_ip_cidr": [
              "172.19.0.1/30",
              "fdfe:dcba:9876::1/126"
            ],
            "invert": true
          }
        ],
        "action": "bypass"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "type": "logical",
            "mode": "and",
            "rules": [
              {
                "inbound": "tun-in"
              },
              {
                "invert": true,
                "port": [
                  53,
                  80,
                  443,
                  853,
                  5222,
                  8443
                ]
              }
            ]
          },
          {
            "source_ip_cidr": [
              "172.19.0.1/30",
              "fdfe:dcba:9876::1/126"
            ],
            "invert": true
          }
        ],
        "action": "bypass"
      },
      {
        "action": "sniff"
      },
      {
        "ip_is_private": true,
        "action": "route",
        "outbound": "direct-out"
      },
      {
        "rule_set": "geosite-cn",
        "action": "route",
        "outbound": "direct-out"
      },
      {
        "rule_set": "geoip-cn",
        "action": "route",
        "outbound": "direct-out"
      },
      {
        "invert": true,
        "port": [
          53,
          80,
          443,
          853,
          5222,
          8443
        ],
        "action": "route",
        "outbound": "direct-out"
      },
      {
        "network": "udp",
        "port": [
          80,
          443
        ],
        "action": "reject",
        "no_drop": true
      }
    ],
    "auto_detect_interface": true,
    "default_domain_resolver": {
      "server": "china-dns"
    },
    "final": "main-out",
    "default_http_client": "main",
    "rule_set": [
      {
        "type": "remote",
        "tag": "geosite-cn",
        "format": "binary",
        "url": "https://fastly.jsdelivr.net/gh/SagerNet/sing-geosite@rule-set/geosite-geolocation-cn.srs"
      },
      {
        "type": "remote",
        "tag": "geoip-cn",
        "format": "binary",
        "url": "https://fastly.jsdelivr.net/gh/SagerNet/sing-geoip@rule-set/geoip-cn.srs"
      }
    ]
  },
  "http_clients": [
    {
      "tag": "main",
      "detour": "main-out"
    }
  ],
  "experimental": {
    "cache_file": {
      "enabled": true,
      "path": "/var/run/cache.db",
      "store_dns": true
    }
  }
}
