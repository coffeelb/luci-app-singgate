USE_PROCD=1
START=99
STOP=10

PROG=/usr/bin/sing-box
CONF_FILE=/etc/singgate/config.json
DEFAULT_WORK_DIR=/etc/singgate

start_service() {
	local err esc work_dir

	[ -s "$CONF_FILE" ] || {
		logger -t singgate -p daemon.err "config file $CONF_FILE is missing or empty"
		return 1
	}

	config_load singgate
	config_get work_dir main work_dir "$DEFAULT_WORK_DIR"
	mkdir -p "$work_dir"

	# The config usually holds credentials; keep it private.
	chmod 0600 "$CONF_FILE"

	err="$("$PROG" check -c "$CONF_FILE" -D "$work_dir" 2>&1)" || {
		esc="$(printf '\033')"
		err="$(printf '%s' "$err" | sed "s/${esc}\[[0-9;]*m//g")"
		logger -t singgate -p daemon.err "config check failed: $err"
		return 1
	}

	procd_open_instance
	procd_set_param command "$PROG" run -c "$CONF_FILE" -D "$work_dir"
	procd_set_param file "$CONF_FILE"
	procd_set_param respawn 3600 5 5
	procd_set_param limits nofile="1000000 1000000"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
