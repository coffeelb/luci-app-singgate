#!/bin/sh /etc/rc.common
# Copyright (C) 2026 COFFEELB
# SPDX-License-Identifier: MIT

# Skip automatic service activation on a fresh APK install.
case "${APK_SCRIPT:-}:${action:-}" in
	post-install:enable|post-install:start) exit 0 ;;
	post-upgrade:start) /etc/init.d/singgate enabled || exit 0 ;;
esac

# Skip automatic enablement while assembling a firmware root filesystem.
if [ -n "${IPKG_INSTROOT:-}" ] && [ "${action:-}" = "enable" ]; then
	exit 0
fi

USE_PROCD=1
START=99
STOP=10
EXTRA_COMMANDS="check_config read_log clear_log"

PROG=/usr/bin/sing-box
CONF_FILE=/etc/singgate/config.json
DEFAULT_WORK_DIR=/etc/singgate
CHECK_FILE=/tmp/singgate-check.json
LOG_DIR=/var/log/singgate
LOG_FILE="$LOG_DIR/singgate.log"

prepare_log() (
	umask 077
	mkdir -p "$LOG_DIR" && : >> "$LOG_FILE"
)

read_log() {
	[ -f "$LOG_FILE" ] || return 0
	tail -n 200 "$LOG_FILE"
}

clear_log() (
	prepare_log || exit 1
	exec 9>"$LOG_DIR/log.lock" || exit 1
	flock -x 9 && : > "$LOG_FILE"
)

strip_hash_comments() {
	# Drop # comments outside strings and JSONC comments from the parser input.
	awk '
	{
		line = ""
		for (i = 1; i <= length($0); i++) {
			c = substr($0, i, 1)
			pair = substr($0, i, 2)
			if (block) {
				if (pair == "*/") {
					block = 0
					line = line pair
					i++
				} else
					line = line c
			} else if (quoted) {
				line = line c
				if (escaped)
					escaped = 0
				else if (c == "\\")
					escaped = 1
				else if (c == "\"")
					quoted = 0
			} else if (pair == "//") {
				line = line substr($0, i)
				break
			} else if (pair == "/*") {
				line = line pair
				block = 1
				i++
			} else if (c == "#") {
				break
			} else {
				line = line c
				if (c == "\"")
					quoted = 1
			}
		}
		print line
	}' "$1"
}

validate_config() {
	local config="$1" work_dir="$2" output_type filter_status=0

	"$PROG" check -c "$config" -D "$work_dir" || return 1

	# A successful root match distinguishes a missing field from a parse failure.
	output_type="$(strip_hash_comments "$config" | jsonfilter -t '@' -t '@.log.output')" || filter_status=$?
	case "$filter_status:$output_type" in
		1:object) return 0 ;;
		0:object'
'*) ;;
		*) printf '%s\n' 'Unable to verify the SingGate log configuration.' >&2; return 1 ;;
	esac
	printf '%s\n' 'Remove log.output. SingGate manages its own log file.' >&2
	return 1
}

check_config() {
	local work_dir

	config_load singgate
	config_get work_dir main work_dir "$DEFAULT_WORK_DIR"
	validate_config "$CHECK_FILE" "$work_dir"
}

start_service() {
	local err esc work_dir

	prepare_log || return 1

	[ -s "$CONF_FILE" ] || {
		printf '%s\n' "config file $CONF_FILE is missing or empty" >> "$LOG_FILE"
		return 1
	}

	config_load singgate
	config_get work_dir main work_dir "$DEFAULT_WORK_DIR"
	mkdir -p "$work_dir"

	# The config usually holds credentials; keep it private.
	chmod 0600 "$CONF_FILE"

	err="$(validate_config "$CONF_FILE" "$work_dir" 2>&1)" || {
		esc="$(printf '\033')"
		err="$(printf '%s' "$err" | sed "s/${esc}\[[0-9;]*m//g")"
		printf '%s\n' "config check failed: $err" >> "$LOG_FILE"
		return 1
	}

	procd_open_instance main
	procd_set_param command /bin/sh -c 'log="$1"; shift; exec "$@" >> "$log" 2>&1' \
		singgate "$LOG_FILE" "$PROG" run -c "$CONF_FILE" -D "$work_dir"
	procd_set_param file "$CONF_FILE"
	procd_set_param respawn 3600 5 5
	procd_set_param limits nofile="1000000 1000000"
	procd_close_instance

	procd_open_instance log_maintenance
	procd_set_param command /bin/sh /usr/libexec/singgate-log "$LOG_DIR"
	procd_set_param respawn 3600 5 5
	procd_close_instance
}
